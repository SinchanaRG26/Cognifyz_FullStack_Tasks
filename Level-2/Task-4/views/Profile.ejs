<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile | Task 4</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f8fafc;
        }

        .profile-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
        }

        .profile-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Profile Header */
        .profile-header {
            text-align: center;
            margin-bottom: 2rem;
            position: relative;
        }

        .avatar {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            color: white;
            font-size: 3rem;
            font-weight: bold;
            border: 4px solid white;
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            transition: transform 0.3s ease;
            cursor: pointer;
            position: relative;
        }

        .avatar:hover {
            transform: scale(1.05);
        }

        .avatar:hover::after {
            content: '📸';
            position: absolute;
            bottom: 0;
            right: 0;
            background: #4f46e5;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            border: 2px solid white;
        }

        .profile-name {
            font-size: 2rem;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .profile-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: #eef2ff;
            color: #4f46e5;
            padding: 0.5rem 1.5rem;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .profile-meta {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            color: #64748b;
            font-size: 0.9rem;
            flex-wrap: wrap;
        }

        .profile-meta span {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin: 2rem 0;
            padding: 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            color: white;
        }

        .stat-item {
            text-align: center;
            padding: 0.5rem;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            font-size: 0.8rem;
            opacity: 0.9;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Info Grid */
        .info-grid {
            display: grid;
            gap: 1rem;
            margin: 2rem 0;
        }

        .info-row {
            display: flex;
            align-items: center;
            padding: 1rem;
            background: #f8fafc;
            border-radius: 12px;
            transition: all 0.3s ease;
            cursor: pointer;
            border: 1px solid transparent;
        }

        .info-row:hover {
            background: #eef2ff;
            transform: translateX(5px);
            border-color: #4f46e5;
        }

        .info-icon {
            width: 45px;
            height: 45px;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            color: #4f46e5;
            font-size: 1.2rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .info-content {
            flex: 1;
        }

        .info-label {
            font-size: 0.75rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1e293b;
        }

        /* Edit Form */
        .edit-form {
            background: #f8fafc;
            border-radius: 12px;
            padding: 1.5rem;
            margin: 2rem 0;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #1e293b;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        /* Settings Panel */
        .settings-panel {
            background: #f8fafc;
            border-radius: 12px;
            padding: 1.5rem;
            margin: 2rem 0;
        }

        .setting-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem;
            border-bottom: 1px solid #e2e8f0;
        }

        .setting-item:last-child {
            border-bottom: none;
        }

        .setting-info h4 {
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .setting-info p {
            color: #64748b;
            font-size: 0.9rem;
        }

        .toggle-switch {
            position: relative;
            width: 60px;
            height: 30px;
            background: #cbd5e1;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .toggle-switch.active {
            background: #4f46e5;
        }

        .toggle-switch::after {
            content: '';
            position: absolute;
            width: 26px;
            height: 26px;
            background: white;
            border-radius: 50%;
            top: 2px;
            left: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .toggle-switch.active::after {
            left: 32px;
        }

        .select-input {
            padding: 0.5rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            background: white;
            cursor: pointer;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 2px solid #f1f5f9;
        }

        .btn {
            flex: 1;
            padding: 0.75rem;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: #4f46e5;
            color: white;
        }

        .btn-primary:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
        }

        .btn-secondary {
            background: #f1f5f9;
            color: #1e293b;
        }

        .btn-secondary:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

        .btn-success {
            background: #10b981;
            color: white;
        }

        .btn-success:hover {
            background: #059669;
        }

        .btn-danger {
            background: #ef4444;
            color: white;
        }

        .btn-danger:hover {
            background: #dc2626;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: #f8fafc;
            border-radius: 15px;
        }

        .empty-state i {
            font-size: 5rem;
            color: #cbd5e1;
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            color: #64748b;
            margin-bottom: 2rem;
        }

        .register-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 1rem 2rem;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .register-btn:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 1rem 1.5rem;
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transform: translateX(400px);
            transition: transform 0.3s ease;
            z-index: 1000;
            border-left: 4px solid #4f46e5;
        }

        .toast.show {
            transform: translateX(0);
        }

        .toast.success { border-left-color: #10b981; }
        .toast.error { border-left-color: #ef4444; }

        /* Hidden class */
        .hidden {
            display: none;
        }

        /* Responsive */
        @media (max-width: 640px) {
            .profile-container {
                padding: 1rem;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
            
            .action-buttons {
                flex-direction: column;
            }
            
            .profile-meta {
                flex-direction: column;
                gap: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="profile-container">
        <div class="profile-card">
            <% if (!users || users.length === 0) { %>
                <!-- Empty State - No Users -->
                <div class="empty-state">
                    <i class="fas fa-user-circle"></i>
                    <h3>No Profile Available</h3>
                    <p>You haven't registered yet. Create your profile now!</p>
                    <button class="register-btn" onclick="window.location='/#home'">
                        <i class="fas fa-user-plus"></i> Register Now
                    </button>
                </div>
            <% } else { %>
                <% 
                // Get the most recent user
                const latestUser = users[users.length - 1];
                const joinDate = new Date().toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
                %>

                <!-- Main Profile View -->
                <div id="profileView">
                    <!-- Profile Header -->
                    <div class="profile-header">
                        <div class="avatar" onclick="showToast('📸 Click to change profile picture', 'info')">
                            <%= latestUser.username.charAt(0).toUpperCase() %>
                        </div>
                        
                        <h1 class="profile-name" id="displayName"><%= latestUser.username %></h1>
                        
                        <div class="profile-badge">
                            <i class="fas fa-check-circle"></i>
                            Verified Account
                        </div>
                        
                        <div class="profile-meta">
                            <span><i class="fas fa-map-marker-alt"></i> Bangalore, India</span>
                            <span><i class="fas fa-calendar"></i> Joined <%= joinDate %></span>
                            <span><i class="fas fa-clock"></i> Last active: Today</span>
                        </div>
                    </div>

                    <!-- Stats Grid -->
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-value"><%= users.length %></div>
                            <div class="stat-label">Total Users</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value"><%= users.indexOf(latestUser) + 1 %></div>
                            <div class="stat-label">Your Rank</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">45</div>
                            <div class="stat-label">Points</div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div style="margin: 2rem 0;">
                        <h3 style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; color: #1e293b;">
                            <i class="fas fa-id-card" style="color: #4f46e5;"></i>
                            Personal Information
                        </h3>
                        
                        <div class="info-grid">
                            <div class="info-row" onclick="showToast('📧 Email: <%= latestUser.email %>', 'info')">
                                <div class="info-icon"><i class="fas fa-envelope"></i></div>
                                <div class="info-content">
                                    <div class="info-label">Email Address</div>
                                    <div class="info-value" id="displayEmail"><%= latestUser.email %></div>
                                </div>
                                <i class="fas fa-chevron-right" style="color: #94a3b8;"></i>
                            </div>
                            
                            <div class="info-row" onclick="showToast('🎂 Age: <%= latestUser.age %> years', 'info')">
                                <div class="info-icon"><i class="fas fa-calendar"></i></div>
                                <div class="info-content">
                                    <div class="info-label">Age</div>
                                    <div class="info-value" id="displayAge"><%= latestUser.age %> years</div>
                                </div>
                                <i class="fas fa-chevron-right" style="color: #94a3b8;"></i>
                            </div>
                            
                            <div class="info-row" onclick="showToast('📱 Phone: <%= latestUser.phone %>', 'info')">
                                <div class="info-icon"><i class="fas fa-phone"></i></div>
                                <div class="info-content">
                                    <div class="info-label">Phone Number</div>
                                    <div class="info-value" id="displayPhone"><%= latestUser.phone %></div>
                                </div>
                                <i class="fas fa-chevron-right" style="color: #94a3b8;"></i>
                            </div>
                            
                            <div class="info-row" onclick="showToast('🆔 User ID: #<%= users.length %>', 'info')">
                                <div class="info-icon"><i class="fas fa-id-card"></i></div>
                                <div class="info-content">
                                    <div class="info-label">User ID</div>
                                    <div class="info-value">#<%= users.length %></div>
                                </div>
                                <i class="fas fa-chevron-right" style="color: #94a3b8;"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="recent-activity" style="background: #f8fafc; border-radius: 12px; padding: 1rem; margin: 2rem 0;">
                        <h4 style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; color: #1e293b;">
                            <i class="fas fa-history" style="color: #4f46e5;"></i>
                            Recent Activity
                        </h4>
                        
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 0.75rem; border-left: 3px solid #4f46e5; background: white; border-radius: 8px; margin-bottom: 0.5rem;">
                            <div style="width: 35px; height: 35px; background: #eef2ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #4f46e5;">
                                <i class="fas fa-user-plus"></i>
                            </div>
                            <div style="flex: 1;">
                                <div style="font-weight: 500; color: #1e293b;">Account created</div>
                                <div style="font-size: 0.8rem; color: #94a3b8;">Just now</div>
                            </div>
                        </div>
                        
                        <div style="display: flex; align-items: center; gap: 1rem; padding: 0.75rem; border-left: 3px solid #10b981; background: white; border-radius: 8px;">
                            <div style="width: 35px; height: 35px; background: #eef2ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #10b981;">
                                <i class="fas fa-gift"></i>
                            </div>
                            <div style="flex: 1;">
                                <div style="font-weight: 500; color: #1e293b;">Welcome bonus earned</div>
                                <div style="font-size: 0.8rem; color: #94a3b8;">Just now</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Edit Profile Form (Hidden by default) -->
                <div id="editForm" class="edit-form hidden">
                    <h3 style="margin-bottom: 1rem; color: #1e293b;">
                        <i class="fas fa-edit" style="color: #4f46e5;"></i> Edit Profile
                    </h3>
                    
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" id="editUsername" class="form-control" value="<%= latestUser.username %>">
                    </div>
                    
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="editEmail" class="form-control" value="<%= latestUser.email %>">
                    </div>
                    
                    <div class="form-group">
                        <label>Age</label>
                        <input type="number" id="editAge" class="form-control" value="<%= latestUser.age %>">
                    </div>
                    
                    <div class="form-group">
                        <label>Phone</label>
                        <input type="tel" id="editPhone" class="form-control" value="<%= latestUser.phone %>">
                    </div>
                    
                    <div class="form-actions">
                        <button class="btn btn-success" onclick="saveProfile()">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                        <button class="btn btn-secondary" onclick="cancelEdit()">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                    </div>
                </div>

                <!-- Settings Panel (Hidden by default) -->
                <div id="settingsPanel" class="settings-panel hidden">
                    <h3 style="margin-bottom: 1rem; color: #1e293b;">
                        <i class="fas fa-cog" style="color: #4f46e5;"></i> Settings
                    </h3>
                    
                    <div class="setting-item">
                        <div class="setting-info">
                            <h4>Email Notifications</h4>
                            <p>Receive updates about your account</p>
                        </div>
                        <div class="toggle-switch active" id="emailToggle" onclick="toggleSetting('email')"></div>
                    </div>
                    
                    <div class="setting-item">
                        <div class="setting-info">
                            <h4>SMS Notifications</h4>
                            <p>Get order updates via text message</p>
                        </div>
                        <div class="toggle-switch" id="smsToggle" onclick="toggleSetting('sms')"></div>
                    </div>
                    
                    <div class="setting-item">
                        <div class="setting-info">
                            <h4>Dark Mode</h4>
                            <p>Switch to dark theme</p>
                        </div>
                        <div class="toggle-switch" id="darkModeToggle" onclick="toggleDarkMode()"></div>
                    </div>
                    
                    <div class="setting-item">
                        <div class="setting-info">
                            <h4>Language</h4>
                            <p>Select your preferred language</p>
                        </div>
                        <select class="select-input" id="languageSelect" onchange="changeLanguage(this.value)">
                            <option value="en">English</option>
                            <option value="hi">Hindi</option>
                            <option value="kn">Kannada</option>
                            <option value="te">Telugu</option>
                        </select>
                    </div>
                    
                    <div class="setting-item">
                        <div class="setting-info">
                            <h4>Privacy</h4>
                            <p>Make profile private</p>
                        </div>
                        <div class="toggle-switch" id="privacyToggle" onclick="toggleSetting('privacy')"></div>
                    </div>
                    
                    <div class="setting-item">
                        <div class="setting-info">
                            <h4>Two-Factor Authentication</h4>
                            <p>Enhance account security</p>
                        </div>
                        <button class="btn btn-secondary" style="padding: 0.5rem 1rem;" onclick="showToast('🔐 2FA setup would be initiated', 'info')">
                            Enable
                        </button>
                    </div>
                    
                    <div style="margin-top: 1rem; padding: 1rem; background: #fee2e2; border-radius: 8px;">
                        <h4 style="color: #ef4444; margin-bottom: 0.5rem;">Danger Zone</h4>
                        <button class="btn btn-danger" style="width: 100%;" onclick="showToast('⚠️ This would delete your account', 'error')">
                            <i class="fas fa-trash"></i> Delete Account
                        </button>
                    </div>
                    
                    <div style="margin-top: 1rem; text-align: right;">
                        <button class="btn btn-secondary" onclick="closeSettings()">
                            <i class="fas fa-times"></i> Close
                        </button>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons" id="actionButtons">
                    <button class="btn btn-primary" onclick="showEditForm()">
                        <i class="fas fa-edit"></i> Edit Profile
                    </button>
                    <button class="btn btn-secondary" onclick="showSettings()">
                        <i class="fas fa-cog"></i> Settings
                    </button>
                </div>

                <!-- Note -->
                <p style="margin-top: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.8rem;">
                    <i class="fas fa-info-circle"></i> 
                    Showing profile of most recent user: <strong><%= latestUser.username %></strong>
                </p>
            <% } %>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast">
        <i class="fas fa-info-circle"></i>
        <span id="toastMessage"></span>
    </div>

    <script>
        // Show toast notification
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            const icon = toast.querySelector('i');
            
            toastMessage.textContent = message;
            
            if (type === 'success') {
                icon.className = 'fas fa-check-circle';
                toast.className = 'toast success show';
            } else if (type === 'error') {
                icon.className = 'fas fa-exclamation-circle';
                toast.className = 'toast error show';
            } else {
                icon.className = 'fas fa-info-circle';
                toast.className = 'toast show';
            }
            
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // Show edit form
        function showEditForm() {
            document.getElementById('profileView').classList.add('hidden');
            document.getElementById('editForm').classList.remove('hidden');
            document.getElementById('settingsPanel').classList.add('hidden');
            document.getElementById('actionButtons').classList.add('hidden');
        }

        // Save profile changes
        function saveProfile() {
            const newUsername = document.getElementById('editUsername').value;
            const newEmail = document.getElementById('editEmail').value;
            const newAge = document.getElementById('editAge').value;
            const newPhone = document.getElementById('editPhone').value;
            
            // Update display
            document.getElementById('displayName').textContent = newUsername;
            document.getElementById('displayEmail').textContent = newEmail;
            document.getElementById('displayAge').textContent = newAge + ' years';
            document.getElementById('displayPhone').textContent = newPhone;
            
            // Hide edit form
            cancelEdit();
            
            // Show success message
            showToast('✅ Profile updated successfully!', 'success');
        }

        // Cancel edit
        function cancelEdit() {
            document.getElementById('profileView').classList.remove('hidden');
            document.getElementById('editForm').classList.add('hidden');
            document.getElementById('settingsPanel').classList.add('hidden');
            document.getElementById('actionButtons').classList.remove('hidden');
        }

        // Show settings
        function showSettings() {
            document.getElementById('profileView').classList.add('hidden');
            document.getElementById('editForm').classList.add('hidden');
            document.getElementById('settingsPanel').classList.remove('hidden');
            document.getElementById('actionButtons').classList.add('hidden');
        }

        // Close settings
        function closeSettings() {
            document.getElementById('profileView').classList.remove('hidden');
            document.getElementById('editForm').classList.add('hidden');
            document.getElementById('settingsPanel').classList.add('hidden');
            document.getElementById('actionButtons').classList.remove('hidden');
        }

        // Toggle settings (notifications, privacy)
        function toggleSetting(setting) {
            const element = document.getElementById(setting + 'Toggle');
            element.classList.toggle('active');
            
            const status = element.classList.contains('active') ? 'enabled' : 'disabled';
            showToast(`⚙️ ${setting} notifications ${status}`, 'info');
        }

        // Toggle dark mode
        function toggleDarkMode() {
            const toggle = document.getElementById('darkModeToggle');
            toggle.classList.toggle('active');
            
            if (toggle.classList.contains('active')) {
                document.body.style.background = '#1e293b';
                document.body.style.color = 'white';
                showToast('🌙 Dark mode enabled', 'success');
            } else {
                document.body.style.background = '#f8fafc';
                document.body.style.color = '#1e293b';
                showToast('☀️ Light mode enabled', 'success');
            }
        }

        // Change language
        function changeLanguage(lang) {
            const languages = {
                'en': 'English',
                'hi': 'Hindi',
                'kn': 'Kannada',
                'te': 'Telugu'
            };
            showToast(`🌐 Language changed to ${languages[lang]}`, 'success');
        }

        // Handle avatar click
        document.querySelector('.avatar')?.addEventListener('click', function() {
            showToast('📸 Profile picture upload feature coming soon!', 'info');
        });
    </script>
</body>
</html>
